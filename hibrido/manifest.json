{
  "manifest_version": 3,
  "name": "GeoLead",
  "version": "2.0",
  "description": "Extrator de Maps e Disparador em massa Premium para WhatsApp Web",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "tabs", "identity", "identity.email"],
  "host_permissions": [
    "*://web.whatsapp.com/*",
    "*://www.google.com/maps/*",
    "*://www.google.com.br/maps/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["*://www.google.com/maps/*", "*://www.google.com.br/maps/*"],
      "js": ["maps_content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://web.whatsapp.com/*"]
    }
  ]
}
